<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center" android:padding="32dp">
    <TextView android:id="@+id/tvResult" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="Нажмите 'Тест'"
        android:textSize="22sp" android:textStyle="bold" android:textAlignment="center"
        android:layout_marginBottom="48dp"/>
    <Button android:id="@+id/btnTest" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Тест" android:textSize="18sp"
        android:layout_marginBottom="16dp"/>
    <Button android:id="@+id/btnExit" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Выход" android:textSize="18sp"/>
</LinearLayout>
